// Stylesheet for `cargo run --example images`.
// `url(...)` is relative to this file. Save while the example runs to reload.
class hero {
    background-image: url(assets/dusk.png)
    background-fit: cover
    foreground: #ffffff
    width: 250; height: 150
    padding: 16; radius: 14
    justify-content: end
    font-size: 18; font-weight: 700
}

// One 36 by 36 SVG stretched over boxes of any size: corners keep their shape.
class frame {
    background-image: url(assets/frame.svg)
    background-slice: 12
    background-tint: foreground
    foreground: #67e8ce
    padding: 16
    align-items: center; justify-content: center
}
