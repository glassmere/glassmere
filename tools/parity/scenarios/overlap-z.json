{
  "id": "overlap-z",
  "title": "Overlapping widgets: which one a click reaches",
  "size": [
    420,
    260
  ],
  "ui": {
    "type": "stack",
    "id": "stage",
    "width": 260,
    "height": 140,
    "background": "#222c3d",
    "children": [
      {
        "type": "button",
        "id": "low",
        "text": "Low (first)",
        "width": 120,
        "height": 60,
        "position": {
          "x": 10,
          "y": 10
        }
      },
      {
        "type": "button",
        "id": "top",
        "text": "Top (later)",
        "width": 120,
        "height": 60,
        "position": {
          "x": 60,
          "y": 30
        }
      },
      {
        "type": "button",
        "id": "lifted",
        "text": "z 5",
        "width": 70,
        "height": 40,
        "position": {
          "x": 180,
          "y": 60
        },
        "z": 5
      },
      {
        "type": "button",
        "id": "over",
        "text": "z 9",
        "width": 100,
        "height": 40,
        "position": {
          "x": 150,
          "y": 70
        },
        "z": 9
      }
    ]
  },
  "steps": [
    {
      "do": "observe",
      "label": "initial"
    },
    {
      "do": "clickAt",
      "target": "low",
      "fx": 0.85,
      "fy": 0.85
    },
    {
      "do": "observe",
      "label": "a click where \"Low\" is covered by \"Top\""
    },
    {
      "do": "clickAt",
      "target": "lifted",
      "fx": 0.3,
      "fy": 0.5
    },
    {
      "do": "observe",
      "label": "a click where a z 5 widget is covered by a z 9 one"
    }
  ]
}