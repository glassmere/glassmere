{
  "id": "scroll",
  "title": "Scrolling: wheel, keyboard, focus on empty scroll areas",
  "size": [
    420,
    340
  ],
  "ui": {
    "type": "column",
    "id": "page",
    "gap": 8,
    "padding": 12,
    "children": [
      {
        "type": "scroll",
        "id": "long",
        "height": 100,
        "width": 300,
        "children": [
          {
            "type": "label",
            "id": "r1",
            "text": "Row 1"
          },
          {
            "type": "label",
            "id": "r2",
            "text": "Row 2"
          },
          {
            "type": "label",
            "id": "r3",
            "text": "Row 3"
          },
          {
            "type": "label",
            "id": "r4",
            "text": "Row 4"
          },
          {
            "type": "label",
            "id": "r5",
            "text": "Row 5"
          },
          {
            "type": "label",
            "id": "r6",
            "text": "Row 6"
          },
          {
            "type": "label",
            "id": "r7",
            "text": "Row 7"
          },
          {
            "type": "label",
            "id": "r8",
            "text": "Row 8"
          },
          {
            "type": "label",
            "id": "r9",
            "text": "Row 9"
          },
          {
            "type": "label",
            "id": "r10",
            "text": "Row 10"
          },
          {
            "type": "label",
            "id": "r11",
            "text": "Row 11"
          },
          {
            "type": "label",
            "id": "r12",
            "text": "Row 12"
          }
        ]
      },
      {
        "type": "scroll",
        "id": "short",
        "height": 80,
        "width": 300,
        "children": [
          {
            "type": "label",
            "id": "s1",
            "text": "Only one row"
          }
        ]
      },
      {
        "type": "button",
        "id": "after",
        "text": "After"
      }
    ]
  },
  "steps": [
    {
      "do": "observe",
      "label": "initial"
    },
    {
      "do": "cursor",
      "label": "pointer over each",
      "targets": [
        "long",
        "short",
        "r1"
      ]
    },
    {
      "do": "wheel",
      "target": "long",
      "dy": 120
    },
    {
      "do": "observe",
      "label": "after a wheel notch over the long area"
    },
    {
      "do": "click",
      "target": "long"
    },
    {
      "do": "observe",
      "label": "after a click on the long scroll area"
    },
    {
      "do": "press",
      "key": "ArrowDown"
    },
    {
      "do": "press",
      "key": "ArrowDown"
    },
    {
      "do": "observe",
      "label": "two ArrowDown with that area focused"
    },
    {
      "do": "click",
      "target": "short"
    },
    {
      "do": "observe",
      "label": "after a click on a scroll area that fits its content"
    },
    {
      "do": "tabSequence",
      "label": "Tab forward",
      "count": 3
    }
  ]
}