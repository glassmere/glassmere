{
  "id": "overflow-visible",
  "title": "overflow: visible: the part of a child that hangs over its parent is drawn and clickable",
  "size": [
    420,
    220
  ],
  "ui": {
    "type": "column",
    "id": "page",
    "gap": 8,
    "padding": 12,
    "children": [
      {
        "type": "stack",
        "id": "window",
        "width": 120,
        "height": 50,
        "overflow": "visible",
        "background": "#222c3d",
        "children": [
          {
            "type": "button",
            "id": "wide",
            "text": "A button wider than its parent",
            "width": 240,
            "height": 36,
            "position": {
              "x": 0,
              "y": 0
            }
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "do": "observe",
      "label": "initial"
    },
    {
      "do": "clickAt",
      "target": "wide",
      "fx": 0.2,
      "fy": 0.5
    },
    {
      "do": "observe",
      "label": "a click on the part inside the parent"
    },
    {
      "do": "clickAt",
      "target": "wide",
      "fx": 0.8,
      "fy": 0.5
    },
    {
      "do": "observe",
      "label": "a click on the part that hangs over"
    }
  ]
}
